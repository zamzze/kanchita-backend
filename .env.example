# Runtime
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Comma-separated browser origins allowed to call the API. Requests without an
# Origin header (for example native or server-to-server clients) remain valid.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Private by default. Set exactly to `true` only during controlled provisioning.
ALLOW_PUBLIC_REGISTRATION=false

# Direct HLS lifecycle. Defaults shown below are used when omitted.
STREAM_CACHE_TTL_MINUTES=60
STREAM_VERIFY_INTERVAL_MINUTES=10
STREAM_VERIFY_TIMEOUT_MS=5000
STREAM_MAX_MANIFEST_BYTES=262144
# Persistent stream-resolution queue and independent worker.
STREAM_WORKER_POLL_MS=1000
STREAM_JOB_LEASE_SECONDS=180
STREAM_JOB_MAX_ATTEMPTS=3
STREAM_RESOLUTION_TIMEOUT_MS=90000
STREAM_RESOLVER_KILL_GRACE_MS=2000
STREAM_PENDING_RETRY_SECONDS=2

# PostgreSQL. Use host `postgres` from inside Docker Compose; use `localhost`
# when running Node directly on the host.
DB_URL=postgresql://streaming_user:replace-me@postgres:5432/streaming_db

# Generate independent high-entropy values, for example with:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_IN=7d
JWT_ISSUER=kanchita-api
JWT_ACCESS_AUDIENCE=kanchita-clients
JWT_REFRESH_AUDIENCE=kanchita-refresh

# External APIs
TMDB_API_KEY=replace-with-your-tmdb-key
SUBDL_API_KEY=replace-with-your-subdl-key

# Optional ingestion settings
INITIAL_MOVIE_PAGES=5
INITIAL_SERIES_PAGES=3

# Currently read by config but not used by the active provider implementation.
PROVIDER_A_URL=

